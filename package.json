{
  "name": "meaworld-company-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @meaworld/web build && pnpm --filter @meaworld/worker build",
    "dev": "pnpm --filter @meaworld/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @meaworld/db migrate",
    "phase0:seed": "pnpm --filter @meaworld/db seed:phase0",
    "phase0:recovery-seed": "pnpm --filter @meaworld/db seed:recovery",
    "worker:once": "pnpm --filter @meaworld/worker once",
    "worker:daemon": "pnpm --filter @meaworld/worker start",
    "loop:enqueue-update": "pnpm --filter @meaworld/db enqueue:repo-update",
    "notion:smoke": "pnpm --filter @meaworld/worker notion:smoke",
    "codex:smoke": "pnpm --filter @meaworld/worker codex:smoke",
    "phase0:gate": "node --import tsx scripts/phase0-gate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "26.1.2",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
